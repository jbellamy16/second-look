# Optional: Azure OpenAI model deployed in Microsoft Foundry. Never use NEXT_PUBLIC for secrets.
FOUNDRY_ENDPOINT=
FOUNDRY_API_KEY=
FOUNDRY_DEPLOYMENT=
# Opt-in required to spend model tokens. Offline demonstration is the default.
FOUNDRY_ENABLED=false
# Process-local budget, max uncached narrations per hour across all visitors.
FOUNDRY_HOURLY_LIMIT=30
