{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "synthetic",
        "historical",
        "live"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": [
        "string",
        "null"
      ]
    },
    "competition": {
      "type": "string",
      "minLength": 1
    },
    "season": {
      "type": [
        "string",
        "null"
      ]
    },
    "venue": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "in_progress",
        "finished"
      ]
    },
    "duration": {
      "type": "number",
      "minimum": 0
    },
    "secondHalfStart": {
      "type": "number",
      "minimum": 0
    },
    "periods": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "1H",
              "2H",
              "E1",
              "E2",
              "PS"
            ]
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          },
          "clockStart": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "start",
          "end",
          "clockStart"
        ],
        "additionalProperties": false
      }
    },
    "pitch": {
      "type": "object",
      "properties": {
        "length": {
          "type": "number",
          "const": 100
        },
        "width": {
          "type": "number",
          "const": 100
        },
        "unit": {
          "type": "string",
          "const": "percent"
        },
        "origin": {
          "type": "string",
          "const": "top-left"
        },
        "yDirection": {
          "type": "string",
          "const": "down"
        },
        "orientation": {
          "type": "string",
          "const": "action-executing-team"
        },
        "referenceLengthMetres": {
          "type": "number",
          "const": 105
        },
        "referenceWidthMetres": {
          "type": "number",
          "const": 68
        },
        "physicalDimensionsKnown": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "length",
        "width",
        "unit",
        "origin",
        "yDirection",
        "orientation",
        "referenceLengthMetres",
        "referenceWidthMetres",
        "physicalDimensionsKnown"
      ],
      "additionalProperties": false
    },
    "teams": {
      "type": "object",
      "properties": {
        "harbor": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "short": {
              "type": "string",
              "minLength": 1
            },
            "color": {
              "type": "string",
              "minLength": 1
            },
            "formation": {
              "type": "string"
            },
            "lineup": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "bench": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "id",
            "name",
            "short",
            "color",
            "lineup",
            "bench"
          ],
          "additionalProperties": false
        },
        "riverside": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "short": {
              "type": "string",
              "minLength": 1
            },
            "color": {
              "type": "string",
              "minLength": 1
            },
            "formation": {
              "type": "string"
            },
            "lineup": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "bench": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "id",
            "name",
            "short",
            "color",
            "lineup",
            "bench"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "harbor",
        "riverside"
      ],
      "additionalProperties": false
    },
    "players": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sourceId": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string"
          },
          "team": {
            "type": "string",
            "enum": [
              "harbor",
              "riverside"
            ]
          },
          "number": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "sourceId",
          "name",
          "role",
          "team",
          "number"
        ],
        "additionalProperties": false
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "matchId": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "teamId": {
            "type": "string",
            "minLength": 1
          },
          "time": {
            "type": "number",
            "minimum": 0
          },
          "period": {
            "type": "string",
            "enum": [
              "1H",
              "2H",
              "E1",
              "E2",
              "PS"
            ]
          },
          "periodSeconds": {
            "type": "number",
            "minimum": 0
          },
          "team": {
            "type": "string",
            "enum": [
              "harbor",
              "riverside"
            ]
          },
          "playerId": {
            "type": "string"
          },
          "actorId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "pass",
              "carry",
              "shot",
              "goal",
              "tackle",
              "interception",
              "recovery",
              "possession",
              "corner",
              "free_kick",
              "foul",
              "substitution",
              "card",
              "period_start",
              "period_end",
              "duel",
              "restart",
              "offside",
              "touch",
              "interruption",
              "save",
              "other"
            ]
          },
          "position": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "end": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false
          },
          "success": {
            "type": "boolean"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "saved",
              "wide",
              "goal"
            ]
          },
          "result": {
            "type": "string"
          },
          "xg": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "recipientId": {
            "type": "string",
            "minLength": 1
          },
          "outgoingId": {
            "type": "string",
            "minLength": 1
          },
          "possessionId": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "scoringTeam": {
            "type": "string",
            "enum": [
              "harbor",
              "riverside"
            ]
          },
          "ownGoal": {
            "type": "boolean"
          },
          "qualifiers": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "relatedEvents": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "statistics": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "number"
            }
          },
          "source": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "matchId": {
                "type": "string",
                "minLength": 1
              },
              "eventId": {
                "type": "string",
                "minLength": 1
              },
              "teamId": {
                "type": "string",
                "minLength": 1
              },
              "playerId": {
                "type": "string"
              },
              "eventType": {
                "type": "string",
                "minLength": 1
              },
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              "precision": {
                "type": "string",
                "enum": [
                  "second",
                  "minute",
                  "millisecond"
                ]
              },
              "reportedMinute": {
                "type": "number",
                "minimum": 0
              },
              "coordinates": {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  },
                  "end": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  },
                  "transform": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "transform"
                ],
                "additionalProperties": false
              },
              "raw": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "provider",
              "matchId",
              "eventId",
              "teamId",
              "playerId",
              "eventType",
              "tags",
              "precision",
              "coordinates",
              "raw"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "matchId",
          "order",
          "teamId",
          "time",
          "period",
          "periodSeconds",
          "team",
          "playerId",
          "actorId",
          "type",
          "position",
          "possessionId",
          "qualifiers",
          "relatedEvents",
          "statistics",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "finalScore": {
      "type": "object",
      "properties": {
        "harbor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "riverside": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "harbor",
        "riverside"
      ],
      "additionalProperties": false
    },
    "attribution": {
      "type": "string",
      "minLength": 1
    },
    "sourceUrl": {
      "type": [
        "string",
        "null"
      ]
    },
    "provenance": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "sourceMatchId": {
          "type": "string",
          "minLength": 1
        },
        "adapterVersion": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "licenseUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "redistribution": {
          "type": "string",
          "enum": [
            "permitted-with-attribution",
            "restricted",
            "owned"
          ]
        },
        "raw": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "provider",
        "sourceMatchId",
        "adapterVersion",
        "revision",
        "license",
        "licenseUrl",
        "redistribution",
        "raw"
      ],
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "recoveries": {
          "type": "boolean"
        },
        "shotOutcomes": {
          "type": "boolean"
        },
        "comparisonScope": {
          "type": "string",
          "enum": [
            "continuous",
            "period"
          ]
        },
        "tracking": {
          "type": "boolean",
          "const": false
        },
        "xg": {
          "type": "boolean"
        },
        "ballRecoveries": {
          "type": "boolean"
        },
        "possession": {
          "type": "string",
          "enum": [
            "generated",
            "recorded",
            "unavailable"
          ]
        },
        "lineups": {
          "type": "boolean"
        },
        "substitutions": {
          "type": "boolean"
        },
        "passRecipients": {
          "type": "boolean"
        },
        "physicalDirection": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "recoveries",
        "shotOutcomes",
        "comparisonScope",
        "tracking",
        "xg",
        "ballRecoveries",
        "possession",
        "lineups",
        "substitutions",
        "passRecipients",
        "physicalDirection"
      ],
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "kind",
    "title",
    "date",
    "competition",
    "season",
    "venue",
    "status",
    "duration",
    "secondHalfStart",
    "periods",
    "pitch",
    "teams",
    "players",
    "events",
    "finalScore",
    "attribution",
    "sourceUrl",
    "provenance",
    "capabilities",
    "limitations"
  ],
  "additionalProperties": false
}
